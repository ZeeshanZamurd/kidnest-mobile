{
  "name": "kidnest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "detect-host": "node scripts/detect-dev-host.js",
    "android": "bash scripts/run-android-device.sh",
    "android:gradle": "adb reverse tcp:8088 tcp:8088 && adb reverse tcp:3010 tcp:3010 && node ./node_modules/react-native/cli.js run-android --port 8088",
    "android:reverse": "adb reverse tcp:8088 tcp:8088 && adb reverse tcp:3010 tcp:3010",
    "android:build": "cd android && ./gradlew app:assembleDebug",
    "android:install": "adb install -r -d android/app/build/outputs/apk/debug/app-debug.apk",
    "android:clean": "cd android && ./gradlew clean && rm -rf app/.cxx app/build build ../node_modules/react-native-reanimated/android/build ../node_modules/react-native-worklets/android/build",
    "android:stop-gradle": "cd android && ./gradlew --stop",
    "ios": "node ./node_modules/react-native/cli.js run-ios",
    "ios:device": "bash scripts/run-ios-device.sh",
    "setup:cocoapods": "bash scripts/setup-cocoapods.sh",
    "lint": "eslint .",
    "prestart": "node -e \"const v=require('react-native/package.json').version; if(v!=='0.80.3'){console.error('Wrong react-native in node_modules:',v,'— run: rm -rf node_modules && npm ci'); process.exit(1)} console.log('Metro: react-native',v);\" && npm run detect-host",
    "preandroid": "npm run detect-host",
    "preios": "npm run detect-host",
    "start": "node ./node_modules/react-native/cli.js start --port 8088",
    "dev:check": "bash scripts/check-dev-env.sh",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "firebase": "^12.15.0",
    "i18next": "^23.16.5",
    "intl-pluralrules": "^2.0.1",
    "react": "19.1.0",
    "react-i18next": "^15.1.1",
    "react-native": "0.80.3",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.3.0",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-pager-view": "^8.0.2",
    "react-native-reanimated": "4.2.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.18.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.19.2",
    "react-native-worklets": "^0.7.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "16.0.0",
    "@react-native-community/cli-platform-android": "16.0.0",
    "@react-native-community/cli-platform-ios": "16.0.0",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/eslint-config": "0.80.3",
    "@react-native/metro-config": "0.80.3",
    "@react-native/typescript-config": "0.80.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro": "^0.81.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react-native": "0.80.3"
  }
}
